# Copy to .env and fill in. Never commit .env.

# Optional: contact added to the User-Agent sent to disclosure sites (recommended courtesy).
TRACKER_CONTACT=

# Optional overrides (defaults shown).
# TRACKER_DB_PATH=~/TradeTracker/tracker.db
# TRACKER_RAW_DIR=~/TradeTracker/raw
# TRACKER_LOG_DIR=~/TradeTracker/logs

# Email alerts (Milestone 1.5). GMAIL_APP_PASSWORD is a Google App Password, not your account password:
# turn on 2-Step Verification, then create one at https://myaccount.google.com/apppasswords.
# Check the setup with: python -m alerts.email --test
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Optional; defaults to GMAIL_ADDRESS.
ALERT_RECIPIENT=

# Agents (Phase 5). Optional: agents run through the Claude Code CLI on your Claude subscription by default.
# Only `python -m agents.ask --api` needs a key (https://console.anthropic.com/settings/keys).
# Optional: where the `claude` CLI is, if it isn't in ~/.local/bin, /opt/homebrew/bin or /usr/local/bin.
# CLAUDE_BIN=
ANTHROPIC_API_KEY=
